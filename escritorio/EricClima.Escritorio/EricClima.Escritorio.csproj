<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>climagestion.ico</ApplicationIcon>
    <AssemblyTitle>ClimaGestión</AssemblyTitle>
    <Product>ClimaGestión</Product>
    <Company>Eric Clima y Servicios</Company>
    <Authors>Alejandro Aguilar Villan</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="conexion.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>